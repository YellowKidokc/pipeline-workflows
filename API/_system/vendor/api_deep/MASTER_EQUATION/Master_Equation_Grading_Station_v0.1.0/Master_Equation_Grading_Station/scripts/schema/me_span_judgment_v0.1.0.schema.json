{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "me_span_judgment_v0.1.0.schema.json",
  "title": "Master Equation span judgment (one span)",
  "type": "object",
  "required": ["role", "slot_signals", "gate_flags", "kill_condition", "confidence", "uncertainty_note"],
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "enum": ["SLOT_CLAIM", "PRODUCT_TEST", "FIT_CLAIM", "DEFINITION",
               "KILL_CONDITION", "EVIDENCE", "MECHANISM", "RHETORIC"]
    },
    "slot_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot_id", "polarity", "fit", "quote"],
        "properties": {
          "slot_id": {
            "type": "string",
            "enum": ["slot.g", "slot.m", "slot.e", "slot.s_eff", "slot.t",
                     "slot.k", "slot.r", "slot.q", "slot.f", "slot.c"]
          },
          "polarity": {"type": "integer", "enum": [1, -1, 0]},
          "fit": {"type": "string", "enum": ["direct", "analogous", "stretched", "absent"]},
          "quote": {"type": "string", "minLength": 1},
          "quote_status": {"type": "string", "enum": ["exact", "normalized", "corrected"]},
          "corrected_sent_range": {
            "type": "array",
            "items": {"type": "integer"},
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "gate_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["no_address", "ungraded_vocabulary", "receipt_missing",
                 "authority_missing", "conflict_suspect"]
      }
    },
    "kill_condition": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_note": {"type": "string"}
  },
  "notes": [
    "Validation in span_judge.py is in-code (validate_judgment), mirroring the fruits judge; this file documents the same contract for downstream consumers.",
    "quote_status/corrected_sent_range are added by the judge after verification; dropped signals never appear in slot_signals (they are recorded under the span record's dropped_signals)."
  ]
}
