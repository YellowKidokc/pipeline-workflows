{
  "station_version": "0.1.0",
  "input_dir": "@paths:gold_canon_source",
  "output_dir": "grading_out",
  "rubric_file": "scripts\\rubric\\fruits_rubric_v0.3.0.json",
  "schema_file": "scripts\\schema\\fruits_report_v0.3.0.schema.json",
  "system_prompt_file": "scripts\\prompts\\fruits_system_v0.3.0.txt",
  "me_rubric_file": "scripts\\rubric\\me_rubric_v0.1.0.json",
  "me_span_schema_file": "scripts\\schema\\me_span_judgment_v0.1.0.schema.json",
  "me_system_prompt_file": "scripts\\prompts\\me_system_v0.1.0.txt",
  "canonical_spec_candidates": [],
  "workbook_directory": "",
  "workbook_patterns": [],
  "include_extensions": [".md", ".txt", ".docx", ".pdf", ".html", ".htm"],
  "exclude_name_contains": [".me.", ".fruits.", "~$"],
  "max_input_characters": 90000,
  "request_timeout_seconds": 240,
  "retry_count": 2,
  "default_workers": 2,
  "default_limit": 2,
  "aggregation_mode": "gated_profile",
  "providers": [
    {
      "name": "deepseek",
      "api_kind": "chat_completions",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "model_env": "ME_DEEPSEEK_MODEL",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0.1,
      "max_output_tokens": 12000,
      "output_token_parameter": "max_tokens"
    }
  ]
}
