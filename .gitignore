# Runtime and private state
.env
config.txt
*.local.*
CONFIG/*.ini
CONFIG/*.json
**/CONFIG/*.ini
**/CONFIG/*.json
!**/CONFIG/*.example.*
# API engine config is code (station list, routines, settings); paths.json stays local
!API/_system/config/*.json
!API/_system/vendor/ckg/CONFIG/ckg.json
API/_system/config/paths.json
services.ini

