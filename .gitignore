qdrant/
chroma/
weaviate/
Data/
databases/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.pickle
*.pkl
*.pt
*.bin
*.onnx

# Generated outputs — packet folders produce these at runtime
**/OUTPUT/*
**/REVIEW/*
**/ARCHIVE/*
**/ERROR/*
**/LOGS/*
!**/OUTPUT/.gitkeep
!**/REVIEW/.gitkeep
!**/ARCHIVE/.gitkeep
!**/ERROR/.gitkeep
!**/LOGS/.gitkeep

# Runtime state — regenerated by orchestrator
STATUS.json
MANIFEST.json
logs/corrections/*.jsonl
*.log

# Local machine config — commit pipeline.config.example.json instead
pipeline.config.json

# Model weight formats — never in repo
*.safetensors

# Caches and build products
__pycache__/
*.pyc
node_modules/
dist/
build/
.venv/
venv/

# Cloudflare / Claude
.wrangler/
.claude/

# Tracking artifacts
*.fis_meta.json
_log.txt
_added.txt
_deleted.txt

# OS/editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Nested git repos (not submodules) - exclude from this repo
.claude/worktrees/
Codex-Powershell_GUI/

# Accidental archive/junk tree with unusable long paths
workflows/New Folder/
API/_system/STATE/
# Local validation/runtime artifacts
pipeline.validated.config.json
X:*
Z:*
workflows/YouTubeChannelRefinery/STATE/*
