  "seven_q": {
    "Q0_posture": "Analytical and constructive; seeks to formalize theological claims in operator algebra with acknowledged reverse-engineering risk",
    "Q1_identity": "An isomorphism record (ISO-013) mapping the grace operator in non-unitary operator algebra to the Christian doctrine of grace",
    "Q2_domain": "Intersection of operator algebra, quantum mechanics, and Christian soteriology",
    "Q3_claim": "The grace operator G = [[1,0],[1,0]] is idempotent, non-unitary, rank-1, and externally sourced, structurally isomorphic to prevenient grace in Christian theology",
    "Q4_support": "Mathematical properties of projection operators; theological doctrines from Ephesians, Hebrews, Romans; impossibility theorems from ISO-002",
    "Q5_dependencies": "ISO-002 (Terminus Sui), ISO-019 (BC8 voluntary coupling), standard operator algebra, Christian soteriology",
    "Q6_consequences": "Justification is idempotent (once-for-all); sanctification is a different operator; Pelagianism is structurally incoherent; sola gratia is mathematically required",
    "Q7_kill": "Show a closed two-state system can spontaneously flip sign; show G^2 != G; show G is invertible; demonstrate a self-generated grace tradition that produces lasting transformation"
  },
