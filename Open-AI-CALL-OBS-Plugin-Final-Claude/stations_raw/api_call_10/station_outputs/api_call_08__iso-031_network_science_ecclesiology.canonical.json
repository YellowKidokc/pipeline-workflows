  "seven_q": {
    "Q0_posture": "Analytical and constructive; the document assumes that structural isomorphisms between mathematics and theology are meaningful and testable.",
    "Q1_identity": "An isomorphism record (ISO-031) that maps network science concepts to New Testament ecclesiology.",
    "Q2_domain": "Interdisciplinary: mathematics (network science) and theology (ecclesiology).",
    "Q3_claim": "The early church's growth, structure, and resilience are accurately modeled by scale-free network dynamics, including preferential attachment, small-world path lengths, high clustering, hub vulnerability, and bridge-tie diffusion.",
    "Q4_support": "Ten independent correspondences, five falsification conditions, bidirectional predictions, and citations from network science literature and scripture.",
    "Q5_dependencies": "Depends on network science models (Barabasi-Albert, Watts-Strogatz, Granovetter) and New Testament textual data (Acts, Pauline epistles).",
    "Q6_consequences": "Forces a structural understanding of church growth as a scale-free network; predicts that organic growth is more resilient than institutional growth; provides a testable framework for analyzing church history.",
    "Q7_kill": "Demonstrate that the early church network does not exhibit scale-free properties (e.g., uniform degree distribution, long path lengths, low clustering) or that institutional churches are equally resilient to persecution."
  },
