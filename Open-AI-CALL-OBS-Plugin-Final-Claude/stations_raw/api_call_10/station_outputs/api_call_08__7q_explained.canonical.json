  "seven_q": {
    "Q0_posture": "Open to inquiry, not pre-committed to any framework or conclusion",
    "Q1_identity": "A methodological framework for analyzing any claim across seven dimensions",
    "Q2_domain": "Epistemology, methodology, with applications to physics and other domains",
    "Q3_claim": "Any claim can be fully understood by answering seven questions: identity, domain, assertion, evidence, dependencies, consequences, and falsification",
    "Q4_support": "The framework is self-supporting through its own application to the example of general relativity, demonstrating its utility",
    "Q5_dependencies": "Depends on the axioms of existence, distinction, observation, and information primacy; requires a posture of openness",
    "Q6_consequences": "Forces a complete analysis of any claim, revealing hidden assumptions, generating predictions, and identifying kill conditions",
    "Q7_kill": "The framework could be killed by demonstrating a claim that cannot be analyzed by these seven questions, or by showing that the framework itself fails one of its own questions"
  },
